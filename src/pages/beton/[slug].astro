---
// Подкатегории бетона в дизайне «Внутренние страницы · после правок»: марка, класс, назначение.
import HomeLayout from '../../layouts/HomeLayout.astro';
import GradePage from '../../components/site/GradePage.astro';
import PurposePage from '../../components/site/PurposePage.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { activeGrades, activeClasses, purposes, gradeSlug, classSlug, byGrade } from '../../lib/inner';
import { productsByGrade, productsByClass } from '../../lib/catalog';
import { seo } from '../../lib/seo';

export function getStaticPaths() {
  return [
    ...activeGrades().map((g) => ({ params: { slug: gradeSlug(g) }, props: { kind: 'grade' as const, value: g } })),
    ...activeClasses().map((c) => ({ params: { slug: `klass-${classSlug(c)}` }, props: { kind: 'class' as const, value: c } })),
    ...purposes.map((p) => ({ params: { slug: `dlya-${p.slug}` }, props: { kind: 'purpose' as const, value: p.slug } })),
  ];
}

type Props = { kind: 'grade' | 'class' | 'purpose'; value: string };
const { kind, value } = Astro.props as Props;
const purpose = kind === 'purpose' ? purposes.find((p) => p.slug === value)! : undefined;
const items = kind === 'grade' ? productsByGrade(value).sort(byGrade) : kind === 'class' ? productsByClass(value).sort(byGrade) : [];
const meta = kind === 'grade' ? seo.grade(value) : kind === 'class' ? seo.klass(value) : seo.purpose(purpose!.name, purpose!.h1);
const grade = items[0]?.grade ?? '';
const cls = items.find((p) => p.class)?.class ?? '';
const h1 = kind === 'grade' ? `Бетон ${value}${cls ? ` ${cls}` : ''}` : `Бетон класса ${value}`;
---
<HomeLayout title={meta.title} description={meta.description}>
  {purpose ? <PurposePage purpose={purpose} /> : <GradePage grade={grade} h1={h1} items={items} href={Astro.url.pathname} label={kind === 'grade' ? `марки ${value}` : `класса ${value}`} />}
  <SiteFooter slot="footer" />
</HomeLayout>
