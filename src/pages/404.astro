---
// 404 в дизайне «3»: шапка внутренней страницы, ссылки на основные разделы, популярное.
import HomeLayout from '../layouts/HomeLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import PopularBlock from '../components/site/PopularBlock.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import Icon from '../components/home/Icon.astro';
const links = [
  ['/catalog/', 'Каталог', 'layers'],
  ['/price/', 'Прайс-лист', 'receipt'],
  ['/poisk/', 'Поиск по сайту', 'search'],
  ['/kontakty/', 'Контакты', 'phone'],
] as const;
---
<HomeLayout title="Страница не найдена" description="Такой страницы нет. Воспользуйтесь каталогом, прайсом или поиском по сайту.">
  <PageHero h1="Страница не найдена" sub="Возможно, адрес изменился или в ссылке опечатка" crumbs={[{ href: '/', label: 'Главная' }, { label: 'Страница не найдена' }]} />
  <section class="sec sec-first" aria-label="Куда перейти">
    <div class="wrap">
      <ul class="items">
        {links.map(([href, label, icon]) => (
          <li class="item"><span class="tile"><Icon name={icon} /></span><div><b><a href={href}>{label}</a></b></div></li>
        ))}
      </ul>
    </div>
  </section>
  <PopularBlock />
  <div class="sec-end"></div>
  <SiteFooter slot="footer" />
</HomeLayout>
