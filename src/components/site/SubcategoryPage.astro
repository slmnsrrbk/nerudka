---
// Подкатегория «вид» (Figma «Подкатегория · вид · Керамзитобетон»): шапка с формой, соседние виды чипами, все позиции вида,
// чем отличается и где применяют, где подходит, доставка, популярное, вопросы, все подкатегории, SEO.
import PageHero from './PageHero.astro';
import PriceSection from './PriceSection.astro';
import DeliveryZones from './DeliveryZones.astro';
import PopularBlock from './PopularBlock.astro';
import FaqSection from './FaqSection.astro';
import LinkCloud from './LinkCloud.astro';
import SeoSection from './SeoSection.astro';
import SectionHead from '../home/SectionHead.astro';
import Icon from '../home/Icon.astro';
import { priceTabs } from '../../lib/home';
import { products, purposes, productsOfCategory, childCategories, getCategory, categoryPath, minPrice, fmt, plural, crumbsFor, img, productPhoto, byGrade, purposeHref, purposeLabel, CATALOG_SUB } from '../../lib/inner';
import type { Category } from '../../lib/types';
interface Props { category: Category }
const { category: cat } = Astro.props;
const root = getCategory(cat.parent!)!;
const items = productsOfCategory(cat.slug).sort(byGrade);
const n = items.length;
const word = plural(n, 'позиция', 'позиции', 'позиций');
const kids = childCategories(root.slug).map((c) => ({ c, k: products.filter((p) => p.category === c.slug).length })).filter((x) => x.k);
const rootCount = kids.reduce((s, x) => s + x.k, 0);
const fillers = new Set(items.map((p) => p.filler));
const twoCols = fillers.has('гравий') && fillers.has('гранит');
const tab = priceTabs().find((t) => t.slug === cat.slug);
const useCount = new Map<string, number>();
for (const p of items) for (const s of p.purposes) useCount.set(s, (useCount.get(s) ?? 0) + 1);
const uses = purposes.filter((p) => useCount.has(p.slug)).sort((a, b) => useCount.get(b.slug)! - useCount.get(a.slug)!);
const usesFor = (slug: string) => items.filter((p) => p.purposes.includes(slug)).map((p) => p.grade || p.density);
const formItems = items.map((p) => ({ id: p.id, label: p.name.replace('Бетон ', '') }));
const lower = cat.name.charAt(0).toLowerCase() + cat.name.slice(1);
---
<PageHero h1={cat.name} sub={CATALOG_SUB} crumbs={crumbsFor(cat)} form formSelected={items[Math.floor(items.length / 2)]?.id} formOptions={formItems} formTopic={`Расчёт цены: ${cat.name}`} />
{tab && <PriceSection head={false} links active={cat.slug} panes={[tab]} />}
<section class="sec sec-tight" aria-labelledby="kind-h">
  <div class="wrap">
    <SectionHead id="kind-h" label="О виде" title="Чем отличается" sub="и где применяют" desc={`Коротко о том, что такое ${lower} и когда его берут.`} />
    <div class="about">
      <img class="about-ph" src={img(productPhoto(items[0]))} alt={`${cat.name}: фото`} width="1024" height="1024" loading="lazy" decoding="async" />
      <div class="about-t card-w">
        <p><b>{cat.name}</b></p>
        <p>{cat.lead}</p>
        {uses.length > 0 && <p><b>Где берут:</b> {uses.map((u) => purposeLabel(u.h1).toLowerCase()).join(', ')}.</p>}
        <p class="muted">[Заглушка: чем {lower} отличается от товарного бетона и как выбрать марку — пришлёт технолог, заменим.]</p>
      </div>
    </div>
  </div>
</section>
{uses.length > 0 && (
  <section class="sec sec-tight" aria-labelledby="fit-h">
    <div class="wrap">
      <SectionHead id="fit-h" label="Подбор" title="Где подходит" sub={lower} desc="Подсказки технолога. Точную марку подберём по проекту." />
      <div class="pur-grid">
        {uses.slice(0, 6).map((u) => (
          <a class="pur" href={purposeHref(u.slug)}>
            <span class="pur-h"><b>{purposeLabel(u.h1)}</b><span class="pur-badge">{[...new Set(usesFor(u.slug))].slice(0, 3).join(', ')}</span></span>
            <span class="pur-d">{u.short}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
<DeliveryZones>
  <div class="grid2">{['Паспорт качества на бетонную смесь — образец', 'Декларация соответствия на товарный бетон'].map((d) => <a class="doc doc-w" href="/kontakty/" data-modal="lead" data-topic={`Запрос документа: ${d}`}><Icon name="file-text" size={24} /><span>{d}</span><span class="fmt">PDF</span><Icon name="download" size={24} /></a>)}</div>
</DeliveryZones>
<PopularBlock />
<FaqSection />
{root.slug === 'beton' && <LinkCloud current={categoryPath(cat)} />}
<SeoSection />
