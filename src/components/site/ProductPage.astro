---
// Страница позиции (Figma «Товар · десктоп», правки 11.10): меню на белой плашке без фото-баннера,
// слева одно фото с маркой поверх, справа название и данные карточки; характеристики, доставка, похожие.
import PlainHeader from './PlainHeader.astro';
import ProductCard from './ProductCard.astro';
import DeliveryZones from './DeliveryZones.astro';
import PopularBlock from './PopularBlock.astro';
import SectionHead from '../home/SectionHead.astro';
import Hook from '../home/Hook.astro';
import Icon from '../home/Icon.astro';
import { products, getCategory, categoryPath, productPath, purposes, img, productPhoto, photoLabel, fmt, specLine, productDescription } from '../../lib/inner';
import { GRADE_SCALE } from '../../lib/catalog';
import type { Product } from '../../lib/types';
interface Props { product: Product }
const { product: p } = Astro.props;
const cat = getCategory(p.category)!;
const parent = cat.parent ? getCategory(cat.parent) : undefined;
const lab = photoLabel(p);
const title = p.category === 'tovarnyj' && p.class ? p.name.replace(` ${p.grade} `, ` ${p.grade} ${p.class} `) : p.name;
const used = p.purposes.map((s) => purposes.find((x) => x.slug === s)).filter(Boolean) as typeof purposes;
const specs: [string, string][] = [
  ['Марка', p.grade], ['Класс прочности', p.class], ['Марка по плотности', p.density], ['Подвижность', p.mobility],
  ['Морозостойкость', p.frost], ['Водонепроницаемость', p.water],
  ['Заполнитель', [p.filler, p.fraction && `фракция ${p.fraction.replace('-', '–')} мм`].filter(Boolean).join(', ')],
  ['Стандарт', p.gost], ['Цена', `${fmt(p.price)} ₽ за м³`],
].filter(([, v]) => v) as [string, string][];
const gi = (x: Product) => GRADE_SCALE.indexOf(x.grade);
const similar = [
  ...products.filter((x) => x.category === p.category && x.id !== p.id).sort((a, b) => Math.abs(gi(a) - gi(p)) - Math.abs(gi(b) - gi(p)) || (a.filler === p.filler ? -1 : 1)),
  ...products.filter((x) => x.category !== p.category && x.grade && x.grade === p.grade),
].slice(0, 4);
const crumbs = [{ href: '/', label: 'Главная' }, { href: '/catalog/', label: 'Каталог' }, ...(parent && parent.slug !== 'beton' ? [{ href: categoryPath(parent), label: parent.name }] : []), { href: categoryPath(cat), label: cat.name }, { label: title }];
const desc = productDescription(p);
const sub = [p.gost, p.mobility, p.frost, p.water, p.fraction && `щебень ${p.fraction.replace('-', '–')} мм`].filter(Boolean).join(' · ');
---
<PlainHeader crumbs={crumbs} />
<section class="sec sec-first" aria-label="Покупка">
  <div class="wrap prod">
    <figure class="prod-ph">
      <img src={img(productPhoto(p))} alt={`${p.name}: фото`} width="1024" height="1024" />
      <figcaption class="prod-lab"><b>{lab.big}</b><span>{p.category === 'tovarnyj' ? `бетон ${p.class} ${lab.small.replace('бетон ', '')}` : lab.small}</span></figcaption>
    </figure>
    <div class="buy" data-item={p.id} data-name={p.name} data-price={p.price} data-href={productPath(p)} data-buy>
      <div class="buy-h"><h1>{title}</h1><p class="small muted">Завод-производитель · 6 РБУ · Доставка в день заказа</p></div>
      <div class="buy-tags">{p.badges?.map((b) => <span class="tag tag-dark">{b}</span>)}<span class="tag">Отгрузка круглосуточно</span>{p.gost && <span class="tag">{p.gost}</span>}</div>
      <p class="buy-p"><b>{fmt(p.price)} ₽</b><span>за м³ с завода</span></p>
      <p class="small muted">{sub}</p>
      <div class="buy-g"><p class="buy-l">Объём, м³</p>
        <div class="buy-v">
          <div class="stepper stepper-l">
            <button type="button" class="st-b" data-dec aria-label="Меньше"><Icon name="minus" size={16} /></button>
            <input class="st-q" value="10" inputmode="decimal" data-qty aria-label="Объём, м³" />
            <button type="button" class="st-b" data-inc aria-label="Больше"><Icon name="plus" size={16} /></button>
          </div>
          {[5, 10, 20, 50].map((v) => <button type="button" class:list={['vchip', { on: v === 10 }]} data-preset={v}>{v} м³</button>)}
        </div>
      </div>
      <div class="buy-sum"><div><span data-buy-calc>10 м³ × {fmt(p.price)} ₽</span><b data-buy-total>{fmt(p.price * 10)} ₽</b></div><p class="small muted" data-buy-hint>От 50 м³ — скидка 10 %, доставка считается по зоне</p></div>
      <div class="buy-btns">
        <button type="button" class="btn btn-dark" data-add>В корзину<Icon name="shopping-cart" size={16} /></button>
        <button type="button" class="btn btn-grey" data-modal="lead" data-topic={`Расчёт с доставкой: ${p.name}`}>Рассчитать с доставкой</button>
      </div>
      <ul class="buy-facts">
        <li><Icon name="truck" />Доставка от 400 ₽ за м³. Заявка до 12:00 — бетон сегодня</li>
        <li><Icon name="file-check" />Паспорт качества и весовая распечатка — с каждой машиной</li>
        <li><Icon name="factory" />Отгрузка с ближайшего из шести РБУ, круглосуточно</li>
      </ul>
    </div>
  </div>
</section>
<!-- Описание и характеристики — два таба без меток раздела (правки заказчика). Оба текста есть в HTML, скрыт только неактивный. -->
<section class="sec sec-tight" id="opisanie" aria-label="Описание и характеристики" data-ptabs>
  <div class="wrap">
    <div class="ptabs" role="tablist" aria-label="Описание и характеристики">
      <button type="button" role="tab" class="ptabs-b on" id="pt-desc" aria-selected="true" aria-controls="pp-desc" data-ptab="desc">Описание</button>
      <button type="button" role="tab" class="ptabs-b" id="pt-specs" aria-selected="false" aria-controls="pp-specs" data-ptab="specs" tabindex="-1">Характеристики</button>
    </div>
    <div class="ptabs-pane" id="pp-desc" role="tabpanel" aria-labelledby="pt-desc" data-ptab-pane="desc">
      <div class="card-w prose-d">{desc.map((t) => <p>{t}</p>)}</div>
    </div>
    <div class="ptabs-pane" id="pp-specs" role="tabpanel" aria-labelledby="pt-specs" data-ptab-pane="specs" hidden>
      <div class="specs">
        <dl class="card-w spec-t">{specs.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}</dl>
        <div class="spec-side">
          {used.length > 0 && <div class="card-w links"><p class="links-h">Подходит для</p>{used.map((u) => <a href={`/beton/dlya-${u.slug}/`}>{u.h1.replace('Бетон для ', '').replace(/^./, (c) => c.toUpperCase())}<Icon name="chevron-right" size={16} /></a>)}</div>}
          {p.note && <p class="note"><Icon name="circle-help" />{p.note}</p>}
        </div>
      </div>
      <p class="small muted ptabs-note">Параметры смеси по паспорту качества. Нужен другой состав — подберём под задачу.</p>
    </div>
  </div>
</section>
<DeliveryZones>
  <div class="grid2">{['Паспорт качества на бетонную смесь — образец', 'Сертификат соответствия ГОСТ 7473-2010'].map((d) => <a class="doc doc-w" href="/kontakty/" data-modal="lead" data-topic={`Запрос документа: ${d}`}><Icon name="file-text" size={24} /><span>{d}</span><span class="fmt">PDF</span><Icon name="download" size={24} /></a>)}</div>
</DeliveryZones>
{similar.length > 0 && (
  <section class="sec sec-tight" aria-labelledby="sim-h">
    <div class="wrap">
      <SectionHead id="sim-h" label="Похожие" title="Похожие позиции" sub="соседние марки" desc="Если нужен запас прочности или экономия — посмотрите соседние марки." />
      <div class="pgrid">{similar.map((x) => <ProductCard product={x} />)}</div>
    </div>
  </section>
)}
<PopularBlock />
<section class="sec sec-tight"><div class="wrap"><Hook icon="calculator" title={`Посчитаем ${p.grade || p.name} с доставкой и скидкой от объёма`} btn="Рассчитать цену" /></div></section>
