---
import Container from './Container.astro';
interface Props { id?: string; name?: string; h1: string; lead?: string; class?: string }
const { id = 'X-01', name = 'H1 и лид', h1, lead, class: cls = '' } = Astro.props;
---
<section data-block={id} data-block-name={name} class:list={['bg-white border-b border-line', cls]}>
  <Container class="py-8 md:py-12">
    <h1 class="text-2xl md:text-4xl font-semibold tracking-tight max-w-4xl">{h1}</h1>
    {lead && <p class="mt-3 max-w-3xl text-ink-2 md:text-lg">{lead}</p>}
    <slot />
  </Container>
</section>
