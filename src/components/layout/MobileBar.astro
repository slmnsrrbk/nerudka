---
import site from '../../data/site.json';
---
<div class="fixed inset-x-0 bottom-0 z-[85] grid grid-cols-3 gap-2 border-t border-line bg-white p-2 md:hidden">
  <a href={`tel:${site.phoneHref}`} class="rounded-md border border-line py-2.5 text-center text-sm">Позвонить</a>
  <a href={site.messengers.whatsapp} class="rounded-md border border-line py-2.5 text-center text-sm">Написать</a>
  <a href="/calculator/" class="rounded-md border border-accent bg-accent py-2.5 text-center text-sm text-accent-ink">Рассчитать</a>
</div>
