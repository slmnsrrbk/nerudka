---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: any;
}
const { href, variant = 'secondary', size = 'md', type = 'button', class: cls = '', ...rest } = Astro.props;
const base = 'inline-flex items-center justify-center gap-2 rounded-md border font-medium transition-colors disabled:opacity-40 disabled:cursor-not-allowed';
const sizes = { md: 'px-5 py-3 text-[15px]', sm: 'px-3 py-2 text-sm' };
const variants = {
  primary: 'bg-accent text-accent-ink border-accent hover:bg-blue-700',
  secondary: 'bg-white text-ink border-line hover:bg-block',
  ghost: 'bg-transparent text-ink-2 border-transparent hover:text-ink hover:bg-block',
};
const classes = [base, sizes[size], variants[variant], cls];
---
{href ? (
  <a href={href} class:list={classes} {...rest}><slot /></a>
) : (
  <button type={type} class:list={classes} {...rest}><slot /></button>
)}
