---
// Подкатегория «марка» и «класс» (Figma «Подкатегория · марка · Бетон М300»): шапка с формой, соседние марки чипами,
// все позиции марки, что значит марка, соседние марки, доставка, популярное, вопросы, облако ссылок, SEO.
import PageHero from './PageHero.astro';
import PriceSection from './PriceSection.astro';
import { tabsForItems } from '../../lib/home';
import NeighborCards from './NeighborCards.astro';
import DeliveryZones from './DeliveryZones.astro';
import PopularBlock from './PopularBlock.astro';
import FaqSection from './FaqSection.astro';
import LinkCloud from './LinkCloud.astro';
import SeoSection from './SeoSection.astro';
import SectionHead from '../home/SectionHead.astro';
import Icon from '../home/Icon.astro';
import DocCard from './DocCard.astro';
import { products, purposes, fmt, plural, betonGrades, gradeHref, purposeHref, purposeLabel, minPrice, CATALOG_SUB } from '../../lib/inner';
import type { Product } from '../../lib/types';
interface Props { grade: string; h1: string; items: Product[]; href: string; label?: string }
const { grade, h1, items, href, label = `марки ${grade}` } = Astro.props;
const tov = products.filter((p) => p.category === 'tovarnyj' && p.grade === grade);
const gr = tov.find((p) => p.filler === 'гравий');
const gn = tov.find((p) => p.filler === 'гранит');
const base = (gr ?? gn ?? items[0])!;
const priceLine = [gr && `На гравии от ${fmt(gr.price)} ₽`, gn && `на граните от ${fmt(gn.price)} ₽`].filter(Boolean).join(', ') || `от ${fmt(minPrice(items))} ₽`;
const sub = [`${priceLine} за м³`, base.mobility, base.frost, base.water, 'доставка от 400 ₽ за м³'].filter(Boolean).join(' · ');
const filler = gr && gn ? 'Гравийный щебень 5–20 мм или гранитный' : base.filler ? `${base.filler}${base.fraction ? `, фракция ${base.fraction}` : ''}` : '';
const specs = [['Класс прочности', base.class], ['Подвижность', base.mobility], ['Морозостойкость', base.frost], ['Водонепроницаемость', base.water], ['Заполнитель', filler], ['Стандарт', base.gost]].filter(([, v]) => v);
const uses = purposes.filter((p) => p.recommended === grade || p.short.includes(grade));
const formItems = (tov.length ? tov : items).map((p) => ({ id: p.id, label: p.name.replace('Бетон ', '') }));
const crumbs = [{ href: '/', label: 'Главная' }, { href: '/catalog/', label: 'Каталог' }, { label: h1.replace(/^Бетон /, '') }];
const isBeton = tov.length > 0;
---
<PageHero h1={h1} sub={CATALOG_SUB} crumbs={crumbs} form formSelected={(gr ?? gn ?? items[0]).id} formOptions={formItems} formTopic={`Расчёт цены: ${h1}`} />
<PriceSection head={false} links active="" panes={tabsForItems(items)} title={{ name: h1, note: `${items.length} ${plural(items.length, 'позиция', 'позиции', 'позиций')} ${label}` }} />
<section class="sec sec-tight" aria-labelledby="mean-h">
  <div class="wrap">
    <SectionHead id="mean-h" label="Характеристики" title={`Марка ${grade}`} sub="что это значит" desc={`Параметры товарного бетона ${grade} по паспорту качества.`} />
    <div class="specs">
      <dl class="spec-t card-w">{specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <div class="spec-side">
        {uses.length > 0 && (
          <nav class="links card-w" aria-label={`Где применяют ${grade}`}>
            <p class="links-h">Где применяют {grade}</p>
            {uses.map((u) => <a href={purposeHref(u.slug)}><span>{purposeLabel(u.h1)}<br /><small class="muted">берут {u.recommended}</small></span><Icon name="chevron-right" size={16} /></a>)}
          </nav>
        )}
        <p class="note"><Icon name="circle-help" size={20} />Точную марку под проект подскажет технолог — бесплатно, по телефону или в мессенджере.</p>
      </div>
    </div>
  </div>
</section>
{isBeton && (
  <section class="sec sec-tight" aria-labelledby="nb-h">
    <div class="wrap">
      <SectionHead id="nb-h" label="Сравнение" title="Соседние марки" sub="дешевле или с запасом" desc="Цены товарного бетона за м³ с завода." />
      <NeighborCards grade={grade} />
    </div>
  </section>
)}
<DeliveryZones>
  <div class="grid2">{['Паспорт качества на бетонную смесь — образец', 'Сертификат соответствия ГОСТ 7473-2010'].map((d) => <DocCard title={d} />)}</div>
</DeliveryZones>
<PopularBlock />
<FaqSection />
<LinkCloud current={href} />
<SeoSection />
