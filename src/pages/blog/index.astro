---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Block from '../../components/ui/Block.astro';
import Container from '../../components/ui/Container.astro';
import ImagePlaceholder from '../../components/ui/ImagePlaceholder.astro';
import posts from '../../data/posts.json';
const rubrics = ['Все', ...new Set(posts.map((p) => p.rubric))];
---
<BaseLayout
  title="Блог о бетоне: выбор марки, расчёты, практика"
  description="Статьи о выборе марки бетона, расчёте объёма, приёмке на объекте и зимнем бетонировании."
  template="T15"
  templateName="Список публикаций"
>
  <Breadcrumbs items={[{ label: 'Блог' }]} />
  <PageHead id="B-01" name="H1 блога" h1="Блог" lead="Короткие разборы вопросов, которые чаще всего задают менеджерам." />

  <Block id="B-02" name="Рубрики">
    <Container class="py-8">
      <div data-filter-group-name="blog" class="flex flex-wrap gap-2">
        {rubrics.map((r, i) => (
          <button type="button" data-filter-value={i === 0 ? 'all' : r}
            class:list={['rounded-md border px-3 py-2 text-sm', i === 0 ? 'border-accent text-accent' : 'border-line hover:border-ink-2']}>
            {r}
          </button>
        ))}
      </div>
    </Container>
  </Block>

  <Block id="B-03" name="Сетка статей" tone="block">
    <Container class="py-12">
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <a href={`/blog/${p.slug}/`} data-filter-key={p.rubric} class="rounded-md border border-line bg-white p-4 hover:border-accent">
            <ImagePlaceholder label={`Иллюстрация: ${p.title.toLowerCase()}`} ratio="16:9" />
            <div class="mt-3 flex items-center gap-2 text-xs text-ink-2">
              <span>{p.date}</span><span>·</span><span>{p.rubric}</span><span>·</span><span>{p.read}</span>
            </div>
            <div class="mt-1 font-medium">{p.title}</div>
            <p class="mt-1 text-sm text-ink-2">{p.excerpt}</p>
          </a>
        ))}
      </div>
    </Container>
  </Block>

  <Block id="B-04" name="Пагинация">
    <Container class="py-8">
      <div class="flex gap-2">
        <span class="rounded-md border border-accent px-3 py-2 text-sm text-accent">1</span>
        <span class="rounded-md border border-line px-3 py-2 text-sm text-ink-2">2</span>
        <span class="rounded-md border border-line px-3 py-2 text-sm text-ink-2">вперёд</span>
      </div>
    </Container>
  </Block>
</BaseLayout>
