---
import Block from '../ui/Block.astro';
import Container from '../ui/Container.astro';
import Btn from '../ui/Btn.astro';
import reviews from '../../data/reviews.json';

interface Props { id?: string; limit?: number; tone?: 'page' | 'block' }
const { id = 'H-13', limit = 3, tone = 'block' } = Astro.props;
const items = reviews.slice(0, limit);
---
<Block id={id} name="Отзывы" tone={tone}>
  <Container class="py-12 md:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="text-xl md:text-2xl font-semibold tracking-tight">Отзывы</h2>
      <Btn href="/otzyvy/" variant="secondary" size="sm">Все отзывы</Btn>
    </div>
    <div class="mt-6 grid gap-3 lg:grid-cols-[280px_1fr]">
      <div class="ph grid place-items-center rounded-md p-6 text-center text-xs text-ink-2" style="min-height:160px">
        Виджет: рейтинг и отзывы на Яндекс Картах
      </div>
      <div class="grid gap-3 md:grid-cols-3">
        {items.map((r) => (
          <figure class="rounded-md border border-line bg-white p-4">
            <blockquote class="text-sm">{r.text}</blockquote>
            <figcaption class="mt-3 text-xs text-ink-2">
              {r.name}, {r.object}
              <span class="mt-1 block">{r.date}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </Container>
</Block>
