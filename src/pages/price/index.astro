---
// Прайс-лист в дизайне «3»: шапка внутренней страницы, блок прайса из макета
// «Вариант · 02 · Прайс-лист — вкладка с одной ценой» (Figma 275:12961), цены на услуги, популярное.
// Вид продукции можно открыть сразу по ссылке: /price/#kladochnyj-rastvor.
import HomeLayout from '../../layouts/HomeLayout.astro';
import PageHero from '../../components/site/PageHero.astro';
import PriceSection from '../../components/site/PriceSection.astro';
import PopularBlock from '../../components/site/PopularBlock.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SectionHead from '../../components/home/SectionHead.astro';
import Icon from '../../components/home/Icon.astro';
import { fmt } from '../../lib/home';
import servicesData from '../../data/services.json';
import type { Service } from '../../lib/types';

const services = servicesData as Service[];
const icons: Record<string, string> = { 'arenda-betononasosa': 'gauge', 'dostavka-mikserom': 'truck', 'laboratornye-ispytaniya': 'flask-conical', 'progrev-betona': 'flame' };
---
<HomeLayout
  title="Прайс-лист на бетон и растворы: цены за м³"
  description="Единый прайс шести РБУ: бетон всех видов, растворы и смеси, скидки от объёма, цены на услуги. Добавьте позиции в корзину — посчитаем заявку."
>
  <PageHero
    h1="Прайс-лист"
    sub="Все виды бетона и растворов. Цены за 1 м³ с завода, на условиях самовывоза — прайс единый для всех шести РБУ"
    crumbs={[{ href: '/', label: 'Главная' }, { label: 'Прайс-лист' }]}
    form
    formTopic="Расчёт по прайсу"
  />

  <PriceSection head={false} />

  <section class="sec" id="uslugi" aria-labelledby="uslugi-h">
    <div class="wrap">
      <SectionHead id="uslugi-h" label="Услуги" title="Цены на услуги" sub="подача и доставка" desc="Стоимость услуг не входит в цену за м³. Точную сумму называем до выезда." />
      <ul class="items">
        {services.map((s) => (
          <li class="item">
            <span class="tile"><Icon name={icons[s.slug] ?? 'package'} /></span>
            <div><b><a href={`/uslugi/${s.slug}/`}>{s.name}</a> — от {fmt(s.priceFrom)} ₽ за {s.priceUnit}</b><span class="small muted">{s.lead}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <PopularBlock />
  <div class="sec-end"></div>
  <SiteFooter slot="footer" />
</HomeLayout>
