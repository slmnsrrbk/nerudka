---
// Прайс-таблица на всю ширину (страница категории): марка → цена на гравии / на граните, счётчик, корзина, «Подробнее».
import Icon from '../home/Icon.astro';
import { rub, fmt, plural, type PriceTab } from '../../lib/home';
interface Props { groups: PriceTab[]; heads?: boolean; open?: number }
const { groups, heads = groups.length > 1, open = 1 } = Astro.props;
const total = groups.reduce((s, g) => s + g.count, 0);
const hiddenCount = groups.slice(open).reduce((s, g) => s + g.count, 0);
---
<div class="ptable" data-ptable>
  <p class="ptable-n">Найдено {total} {plural(total, 'позиция', 'позиции', 'позиций')}</p>
  {groups.map((t, gi) => (
    <div class="pgroup" data-pgroup hidden={gi >= open}>
      {heads && <div class="pgroup-h"><h3 class="h3"><a href={t.href}>{t.name}</a></h3><span class="small muted">{t.note}</span></div>}
      <div class:list={['prow', 'prow-head', { two: t.columns.length > 1 }]}><span>Марка</span>{t.columns.map((c) => <span>{c}</span>)}</div>
      <div class="prows">
        {t.rows.map((r) => (
          <div class:list={['prow', { two: t.columns.length > 1 }]}>
            <div class="prow-name"><a href={(r.cells.find(Boolean))!.href}>{r.title}</a><span>{r.sub}</span></div>
            {r.cells.map((c, i) => c ? (
              <div class="pcell" data-item={c.id} data-name={c.name} data-price={c.price} data-href={c.href}>
                <span class="pcell-l">{t.columns[i].replace(' · за м³', '')}</span>
                <b class="pcell-p">{rub(c.price)}</b>
                <div class="pact">
                  <div class="stepper">
                    <button type="button" class="st-b" data-dec aria-label="Меньше"><Icon name="minus" size={14} /></button>
                    <input class="st-q" value="1" inputmode="decimal" data-qty aria-label="Объём, м³" />
                    <button type="button" class="st-b" data-inc aria-label="Больше"><Icon name="plus" size={14} /></button>
                    <button type="button" class="st-cart" data-add aria-label={`Добавить в корзину: ${c.name}`}><Icon name="shopping-cart" size={16} /></button>
                  </div>
                  <a class="more" href={c.href}>Подробнее<Icon name="arrow-right" size={16} /></a>
                </div>
              </div>
            ) : (
              <div class="pcell pcell-none"><span class="pcell-l">{t.columns[i].replace(' · за м³', '')}</span><b class="pcell-p">—</b></div>
            ))}
          </div>
        ))}
      </div>
    </div>
  ))}
  <div class="strip">
    <span class="tile tile-grey"><Icon name="percent" /></span>
    <div><p class="strip-t">От 50 м³ — скидка 10 %, от 200 м³ — 15 %, от 500 м³ — 20 %</p><p class="small muted">Скидку учтём в расчёте цены и в корзине</p></div>
  </div>
  <div class="ptable-f">
    <a class="btn btn-dark" href="/price/">Скачать прайс PDF<Icon name="download" size={16} /></a>
    {hiddenCount > 0 && <button type="button" class="btn btn-grey" data-pmore>Показать ещё {hiddenCount} {plural(hiddenCount, 'позицию', 'позиции', 'позиций')}</button>}
  </div>
</div>
