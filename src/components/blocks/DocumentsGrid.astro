---
import Block from '../ui/Block.astro';
import Container from '../ui/Container.astro';
import Btn from '../ui/Btn.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import documents from '../../data/documents.json';

interface Props { id?: string; limit?: number; showFilter?: boolean; tone?: 'page' | 'block' }
const { id = 'H-14', limit = 6, showFilter = false, tone = 'page' } = Astro.props;
const items = documents.slice(0, limit);
const types = [
  { id: 'all', name: 'Все' },
  { id: 'certificate', name: 'Сертификаты' },
  { id: 'declaration', name: 'Декларации' },
  { id: 'protocol', name: 'Протоколы' },
  { id: 'passport', name: 'Паспорта' },
  { id: 'contract', name: 'Договоры' },
];
---
<Block id={id} name="Документы" tone={tone}>
  <Container class="py-12 md:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="text-xl md:text-2xl font-semibold tracking-tight">Документы и сертификаты</h2>
      {!showFilter && <Btn href="/sertifikaty/" variant="secondary" size="sm">Все документы</Btn>}
    </div>

    {showFilter && (
      <div data-filter-group-name="docs" class="mt-5 flex flex-wrap gap-2">
        {types.map((t, i) => (
          <button
            type="button"
            data-filter-value={t.id}
            class:list={['rounded-md border px-3 py-2 text-sm', i === 0 ? 'border-accent text-accent' : 'border-line']}
          >{t.name}</button>
        ))}
      </div>
    )}

    <div class="mt-6 grid gap-3 md:grid-cols-3 lg:grid-cols-4">
      {items.map((d) => (
        <figure data-filter-key={d.type} class="rounded-md border border-line bg-white p-3">
          <ImagePlaceholder label="Скан документа" ratio="3:4" />
          <figcaption class="mt-3 text-sm font-medium">{d.title}</figcaption>
          <p class="mt-1 text-xs text-ink-2">{d.note}</p>
        </figure>
      ))}
    </div>
  </Container>
</Block>
