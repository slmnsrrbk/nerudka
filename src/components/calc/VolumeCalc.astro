---
import Btn from '../ui/Btn.astro';
interface Props { defaultShape?: 'slab' | 'strip' | 'columns'; class?: string }
const { defaultShape = 'slab', class: cls = '' } = Astro.props;
const inputCls = 'w-full rounded-md border border-line bg-white px-3 py-2.5 text-[15px] outline-none focus:border-accent';
const shapes = [
  { id: 'slab', label: 'Плита, стяжка, отмостка' },
  { id: 'strip', label: 'Ленточный фундамент' },
  { id: 'columns', label: 'Столбы и сваи' },
];
---
<div data-calc="volume" data-vc-default={defaultShape} class:list={['rounded-md border border-line bg-white p-5', cls]}>
  <h3 class="text-lg font-semibold">Расчёт объёма</h3>
  <p class="mt-1 text-sm text-ink-2">Посчитаем кубометры по размерам конструкции и добавим запас 5 процентов.</p>

  <label class="mt-4 grid gap-1.5">
    <span class="text-xs text-ink-2">Конструкция</span>
    <select data-vc-shape class={inputCls}>
      {shapes.map((s) => <option value={s.id} selected={s.id === defaultShape}>{s.label}</option>)}
    </select>
  </label>

  <div data-vc-fields="slab" class="mt-3 grid gap-3 md:grid-cols-3">
    <label class="grid gap-1.5"><span class="text-xs text-ink-2">Длина, м</span><input type="number" name="length" value="8" step="0.1" class={inputCls} /></label>
    <label class="grid gap-1.5"><span class="text-xs text-ink-2">Ширина, м</span><input type="number" name="width" value="10" step="0.1" class={inputCls} /></label>
    <label class="grid gap-1.5"><span class="text-xs text-ink-2">Толщина, м</span><input type="number" name="thickness" value="0.3" step="0.01" class={inputCls} /></label>
  </div>

  <div data-vc-fields="strip" class="mt-3 hidden gap-3 md:grid-cols-3">
    <label class="grid gap-1.5"><span class="text-xs text-ink-2">Периметр, м</span><input type="number" name="perimeter" value="36" step="0.1" class={inputCls} /></label>
    <label class="grid gap-1.5"><span class="text-xs text-ink-2">Ширина ленты, м</span><input type="number" name="width" value="0.4" step="0.01" class={inputCls} /></label>
    <label class="grid gap-1.5"><span class="text-xs text-ink-2">Высота, м</span><input type="number" name="height" value="0.8" step="0.01" class={inputCls} /></label>
  </div>

  <div data-vc-fields="columns" class="mt-3 hidden gap-3 md:grid-cols-3">
    <label class="grid gap-1.5"><span class="text-xs text-ink-2">Диаметр, м</span><input type="number" name="diameter" value="0.3" step="0.01" class={inputCls} /></label>
    <label class="grid gap-1.5"><span class="text-xs text-ink-2">Глубина, м</span><input type="number" name="height" value="2" step="0.1" class={inputCls} /></label>
    <label class="grid gap-1.5"><span class="text-xs text-ink-2">Количество</span><input type="number" name="count" value="12" step="1" class={inputCls} /></label>
  </div>

  <div class="mt-4 rounded-md border border-dashed border-line bg-block p-4">
    <div class="text-2xl font-semibold" data-vc-result>0 м³</div>
    <div class="text-sm text-ink-2" data-vc-reserve>0 м³ с запасом 5 процентов</div>
  </div>
  <Btn variant="secondary" class="mt-3 w-full" data-vc-apply>Подставить в расчёт стоимости</Btn>
</div>
