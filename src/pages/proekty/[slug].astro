---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Block from '../../components/ui/Block.astro';
import Container from '../../components/ui/Container.astro';
import ImagePlaceholder from '../../components/ui/ImagePlaceholder.astro';
import ProjectsGrid from '../../components/blocks/ProjectsGrid.astro';
import CtaFinal from '../../components/blocks/CtaFinal.astro';
import projects from '../../data/projects.json';
import { getGeo, geoPath } from '../../lib/geo';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props as { project: (typeof projects)[number] };
const geo = getGeo(project.geo);
const passport = [
  { k: 'Объект', v: project.name },
  { k: 'Задача', v: project.task },
  { k: 'Марка', v: project.grade },
  { k: 'Объём', v: `${project.volume} м³` },
  { k: 'Сроки', v: project.period },
  { k: 'Техника', v: project.tech },
];
---
<BaseLayout
  title={`${project.name}: поставка бетона`}
  description={`${project.task} Объём ${project.volume} м³, марка ${project.grade}.`}
  template="T13"
  templateName="Проект"
>
  <Breadcrumbs items={[{ href: '/proekty/', label: 'Проекты' }, { label: project.name }]} />
  <PageHead id="PD-01" name="H1 проекта" h1={project.name} lead={project.task} />

  <Block id="PD-02" name="Паспорт проекта">
    <Container class="py-10">
      <div class="table-scroll rounded-md border border-line bg-white">
        <table class="w-full min-w-[480px] text-sm">
          <tbody class="divide-y divide-line">
            {passport.map((row) => (
              <tr><td class="w-1/3 px-4 py-3 text-ink-2">{row.k}</td><td class="px-4 py-3">{row.v}</td></tr>
            ))}
            {geo && (
              <tr>
                <td class="px-4 py-3 text-ink-2">Город</td>
                <td class="px-4 py-3"><a href={geoPath(geo.slug)} class="text-accent underline-offset-2 hover:underline">{geo.name}</a></td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </Container>
  </Block>

  <Block id="PD-03" name="Галерея" tone="block">
    <Container class="py-12">
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
        {[1, 2, 3, 4].map((i) => <ImagePlaceholder label={`Фото ${i}: ход работ на объекте`} ratio="4:3" />)}
      </div>
    </Container>
  </Block>

  <Block id="PD-04" name="Текст о ходе работ">
    <Container class="py-12">
      <div class="max-w-3xl">
        <h2 class="text-lg font-semibold">Как шла поставка</h2>
        <p class="mt-3 text-[15px] text-ink-2">{project.text}</p>
      </div>
    </Container>
  </Block>

  {project.review && (
    <Block id="PD-05" name="Отзыв заказчика" tone="block">
      <Container class="py-12">
        <figure class="max-w-3xl rounded-md border border-line bg-white p-6">
          <blockquote class="text-[15px]">{project.review}</blockquote>
          <figcaption class="mt-3 text-sm text-ink-2">Отзыв заказчика объекта</figcaption>
        </figure>
      </Container>
    </Block>
  )}

  <ProjectsGrid id="PD-06" limit={3} exclude={project.slug} title="Другие проекты" />
  <CtaFinal id="PD-07" title="Нужен похожий объём?" text="Составим график подачи и зарезервируем технику под ваши даты." />
</BaseLayout>
