---
import Block from '../ui/Block.astro';
import Container from '../ui/Container.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import servicesData from '../../data/services.json';
import { formatPrice } from '../../lib/price';
import type { Service } from '../../lib/types';

interface Props { id?: string; tone?: 'page' | 'block'; title?: string }
const { id = 'H-10', tone = 'block', title = 'Услуги' } = Astro.props;
const services = servicesData as Service[];
---
<Block id={id} name="Услуги" tone={tone}>
  <Container class="py-12 md:py-20">
    <h2 class="text-xl md:text-2xl font-semibold tracking-tight">{title}</h2>
    <div class="mt-6 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => (
        <a href={`/uslugi/${s.slug}/`} class="rounded-md border border-line bg-white p-4 transition-colors hover:border-accent">
          <ImagePlaceholder label={`Фото: ${s.name.toLowerCase()}`} ratio="4:3" />
          <div class="mt-3 font-medium">{s.name}</div>
          <p class="mt-1 text-sm text-ink-2">{s.lead}</p>
          <div class="mt-3 text-sm">от {formatPrice(s.priceFrom)} ₽ за {s.priceUnit}</div>
        </a>
      ))}
    </div>
  </Container>
</Block>
