---
// Каталог с фасетным фильтром. Используется на /catalog/ и на страницах категорий.
// Фильтрация идёт на клиенте: позиций немного, зато отклик мгновенный,
// а состояние пишется в адресную строку, чтобы ссылкой можно было поделиться.
import Container from '../ui/Container.astro';
import Block from '../ui/Block.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import { productPath, getCategory, categories } from '../../lib/catalog';
import { formatPrice } from '../../lib/price';
import purposesData from '../../data/purposes.json';
import type { Product } from '../../lib/types';

interface Props {
  items: Product[];
  id?: string;
  showKindFacet?: boolean;
}
const { items, id = 'C-05', showKindFacet = true } = Astro.props;
const purposes = purposesData as { slug: string; h1: string }[];

const uniq = (values: string[]) => [...new Set(values.filter(Boolean))];
const byNum = (a: string, b: string) => (parseFloat(a.replace(/[^\d.,]/g, '').replace(',', '.')) || 0) - (parseFloat(b.replace(/[^\d.,]/g, '').replace(',', '.')) || 0);

// Виды показываем сгруппированными по разделу, как в структуре каталога.
const kindGroups = categories
  .filter((c) => c.parent === null)
  .map((root) => ({
    root,
    kinds: categories
      .filter((c) => c.parent === root.slug)
      .map((c) => ({ ...c, count: items.filter((p) => p.category === c.slug).length }))
      .filter((c) => c.count > 0),
  }))
  .filter((g) => g.kinds.length > 0);

const facets = [
  { key: 'grade', title: 'Марка', type: 'chips', options: uniq(items.map((p) => p.grade)).sort(byNum) },
  { key: 'class', title: 'Класс прочности', type: 'chips', options: uniq(items.map((p) => p.class)).sort(byNum) },
  { key: 'density', title: 'Плотность', type: 'chips', options: uniq(items.map((p) => p.density)).sort(byNum) },
  { key: 'filler', title: 'Заполнитель', type: 'list', options: uniq(items.map((p) => p.filler)).sort() },
  { key: 'mobility', title: 'Подвижность', type: 'chips', options: uniq(items.map((p) => p.mobility)).sort() },
  { key: 'frost', title: 'Морозостойкость', type: 'chips', options: uniq(items.map((p) => p.frost)).sort(byNum) },
  { key: 'water', title: 'Водонепроницаемость', type: 'chips', options: uniq(items.map((p) => p.water)).sort(byNum) },
].filter((f) => f.options.length > 1);

const purposeOptions = purposes
  .map((p) => ({ ...p, count: items.filter((i) => i.purposes.includes(p.slug)).length }))
  .filter((p) => p.count > 0);

const prices = items.map((p) => p.price);
const minPriceValue = Math.min(...prices);
const maxPriceValue = Math.max(...prices);

const attrs = (p: Product) => ({
  'data-product': '',
  'data-kind': p.category,
  'data-grade': p.grade,
  'data-class': p.class,
  'data-density': p.density,
  'data-filler': p.filler,
  'data-mobility': p.mobility,
  'data-frost': p.frost,
  'data-water': p.water,
  'data-purpose': p.purposes.join(','),
  'data-price': String(p.price),
  'data-name': `${p.name} ${getCategory(p.category)?.name ?? ''}`.toLowerCase(),
});
const inputCls = 'w-full rounded-md border border-line bg-white px-3 py-2 text-sm outline-none focus:border-accent';
---
<Block id={id} name="Каталог с фильтром">
  <Container class="py-8 md:py-10">
    <div data-catalog class="grid gap-6 lg:grid-cols-[280px_1fr]">

      <!-- Панель фильтров -->
      <aside data-facets class="hidden lg:block">
        <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto rounded-md border border-line bg-white">
          <div class="flex items-center justify-between border-b border-line px-4 py-3">
            <span class="font-medium">Фильтр</span>
            <button type="button" data-facets-reset class="text-sm text-accent underline-offset-2 hover:underline">Сбросить</button>
          </div>

          <div class="divide-y divide-line">
            {showKindFacet && kindGroups.map((group) => (
              <details open class="px-4 py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-medium">{group.root.name}<span class="facet-caret text-ink-2"></span></summary>
                <div class="mt-3 grid gap-1.5">
                  {group.kinds.map((k) => (
                    <label class="flex items-center justify-between gap-2 text-sm" data-facet-option={`kind:${k.slug}`}>
                      <span class="flex items-center gap-2">
                        <input type="checkbox" data-facet="kind" value={k.slug} class="size-4 accent-[#2563EB]" />
                        <span>{k.name}</span>
                      </span>
                      <span data-facet-count class="text-xs text-ink-2">{k.count}</span>
                    </label>
                  ))}
                </div>
              </details>
            ))}

            {purposeOptions.length > 0 && (
              <details open class="px-4 py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-medium">Назначение<span class="facet-caret text-ink-2"></span></summary>
                <div class="mt-3 grid gap-1.5">
                  {purposeOptions.map((p) => (
                    <label class="flex items-center justify-between gap-2 text-sm" data-facet-option={`purpose:${p.slug}`}>
                      <span class="flex items-center gap-2">
                        <input type="checkbox" data-facet="purpose" value={p.slug} class="size-4 accent-[#2563EB]" />
                        <span>{p.h1.replace('Бетон для ', '').replace('Бетон ', '')}</span>
                      </span>
                      <span data-facet-count class="text-xs text-ink-2">{p.count}</span>
                    </label>
                  ))}
                </div>
              </details>
            )}

            {facets.map((facet) => (
              <details open={facet.key === 'grade' || facet.key === 'filler'} class="px-4 py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-medium">{facet.title}<span class="facet-caret text-ink-2"></span></summary>
                {facet.type === 'chips' ? (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {facet.options.map((value) => (
                      <label data-facet-option={`${facet.key}:${value}`} class="cursor-pointer">
                        <input type="checkbox" data-facet={facet.key} value={value} class="peer sr-only" />
                        <span class="inline-flex items-center gap-1 rounded-md border border-line px-2 py-1 text-xs peer-checked:border-accent peer-checked:text-accent">
                          {value}<span data-facet-count class="text-ink-2"></span>
                        </span>
                      </label>
                    ))}
                  </div>
                ) : (
                  <div class="mt-3 grid gap-1.5">
                    {facet.options.map((value) => (
                      <label class="flex items-center justify-between gap-2 text-sm" data-facet-option={`${facet.key}:${value}`}>
                        <span class="flex items-center gap-2">
                          <input type="checkbox" data-facet={facet.key} value={value} class="size-4 accent-[#2563EB]" />
                          <span>{value}</span>
                        </span>
                        <span data-facet-count class="text-xs text-ink-2"></span>
                      </label>
                    ))}
                  </div>
                )}
              </details>
            ))}

            <div class="px-4 py-3">
              <p class="text-sm font-medium">Цена за м³</p>
              <div class="mt-3 flex items-center gap-2">
                <input type="number" data-facet-min placeholder={String(minPriceValue)} class={inputCls} />
                <span class="text-ink-2">:</span>
                <input type="number" data-facet-max placeholder={String(maxPriceValue)} class={inputCls} />
              </div>
              <p class="mt-2 text-xs text-ink-2">В каталоге от {formatPrice(minPriceValue)} до {formatPrice(maxPriceValue)} ₽</p>
            </div>
          </div>
        </div>
      </aside>

      <!-- Результаты -->
      <div class="min-w-0">
        <div class="rounded-md border border-line bg-white p-3">
          <div class="flex flex-wrap items-center gap-2">
            <input type="search" data-catalog-search placeholder="Поиск по названию, например М300 или керамзит" class={`${inputCls} min-w-[200px] flex-1`} />
            <select data-catalog-sort class={`${inputCls} w-auto`}>
              <option value="popular">Сначала популярные</option>
              <option value="price-asc">Сначала дешевле</option>
              <option value="price-desc">Сначала дороже</option>
              <option value="grade-asc">По возрастанию марки</option>
              <option value="name">По названию</option>
            </select>
            <div class="flex gap-1.5">
              <button type="button" data-view="table" class="rounded-md border border-accent px-3 py-2 text-sm text-accent">Таблица</button>
              <button type="button" data-view="cards" class="rounded-md border border-line px-3 py-2 text-sm">Карточки</button>
            </div>
            <button type="button" data-facets-open class="rounded-md border border-line px-3 py-2 text-sm lg:hidden">
              Фильтр<span data-facets-badge class="ml-1 hidden rounded bg-accent px-1.5 text-xs text-accent-ink"></span>
            </button>
          </div>

          <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-ink-2">Найдено: <b data-catalog-count class="text-ink">{items.length}</b> из {items.length}</span>
            <span data-catalog-chips class="flex flex-wrap gap-1.5"></span>
          </div>
        </div>

        <div data-catalog-empty class="mt-4 hidden rounded-md border border-dashed border-line bg-block p-8 text-center">
          <p class="font-medium">Под такие условия ничего не нашлось</p>
          <p class="mt-1 text-sm text-ink-2">Снимите часть фильтров или сбросьте их полностью.</p>
          <button type="button" data-facets-reset class="mt-4 rounded-md border border-accent px-4 py-2 text-sm text-accent">Сбросить фильтр</button>
        </div>

        <div data-view-panel="table" class="mt-4">
          <div class="table-scroll rounded-md border border-line bg-white">
            <table class="w-full min-w-[760px] text-sm">
              <thead class="bg-block text-left text-xs text-ink-2">
                <tr>
                  <th class="px-4 py-3 font-medium">Наименование</th>
                  <th class="px-3 py-3 font-medium">Класс</th>
                  <th class="px-3 py-3 font-medium">П</th>
                  <th class="px-3 py-3 font-medium">F</th>
                  <th class="px-3 py-3 font-medium">W</th>
                  <th class="px-3 py-3 font-medium">Заполнитель</th>
                  <th class="px-3 py-3 font-medium">Цена за м³</th>
                  <th class="px-4 py-3"></th>
                </tr>
              </thead>
              <tbody data-catalog-rows class="divide-y divide-line">
                {items.map((p) => (
                  <tr {...attrs(p)} data-row-href={productPath(p)} class="cursor-pointer hover:bg-block">
                    <td class="px-4 py-3">
                      <a href={productPath(p)} class="font-medium hover:text-accent">{p.name}</a>
                      {p.badges.length > 0 && <span class="ml-2 rounded border border-line px-1.5 py-0.5 text-[11px] text-ink-2">{p.badges[0]}</span>}
                      <span class="block text-xs text-ink-2">{getCategory(p.category)?.name}</span>
                    </td>
                    <td class="px-3 py-3 text-ink-2">{p.class || p.density || 'нет'}</td>
                    <td class="px-3 py-3 text-ink-2">{p.mobility}</td>
                    <td class="px-3 py-3 text-ink-2">{p.frost}</td>
                    <td class="px-3 py-3 text-ink-2">{p.water || 'нет'}</td>
                    <td class="px-3 py-3 text-ink-2">{p.filler || 'нет'}</td>
                    <td class="whitespace-nowrap px-3 py-3 font-medium">{formatPrice(p.price)} ₽</td>
                    <td class="px-4 py-3 text-right">
                      <button type="button" data-add-to-request data-id={p.id} data-volume="10"
                        class="rounded-md border border-line px-3 py-1.5 text-xs hover:border-accent hover:text-accent">В заявку</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div data-view-panel="cards" class="mt-4 hidden">
          <div data-catalog-cards class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
            {items.map((p) => (
              <div {...attrs(p)} class="flex flex-col rounded-md border border-line bg-white p-4">
                <ImagePlaceholder label={`Фото: ${p.name.toLowerCase()}`} ratio="4:3" />
                <a href={productPath(p)} class="mt-3 font-medium hover:text-accent">{p.name}</a>
                <p class="mt-1 text-xs text-ink-2">{getCategory(p.category)?.name}</p>
                <p class="mt-2 text-sm text-ink-2">{p.note}</p>
                <div class="mt-3 flex flex-wrap gap-1.5 text-xs text-ink-2">
                  {[p.class || p.density, p.mobility, p.frost, p.water, p.filler].filter(Boolean).map((v) => (
                    <span class="rounded border border-line px-1.5 py-0.5">{v}</span>
                  ))}
                </div>
                <div class="mt-4 flex items-center justify-between">
                  <span class="font-medium">{formatPrice(p.price)} ₽ за м³</span>
                  <button type="button" data-add-to-request data-id={p.id} data-volume="10"
                    class="rounded-md border border-line px-3 py-1.5 text-xs hover:border-accent hover:text-accent">В заявку</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Container>
</Block>
