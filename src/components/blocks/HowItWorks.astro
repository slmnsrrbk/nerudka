---
import Block from '../ui/Block.astro';
import Container from '../ui/Container.astro';
import site from '../../data/site.json';
const steps = [
  { title: 'Заявка', text: 'Звонок, форма или мессенджер. Уточняем марку, объём, адрес и условия подъезда.' },
  { title: 'Подтверждение и счёт', text: 'Фиксируем цену со смесью и доставкой, резервируем технику на время отгрузки.' },
  { title: 'Отгрузка с паспортом качества', text: 'Весовой контроль на узле, ТТН и паспорт качества на каждую машину.' },
  { title: 'Выгрузка на объекте', text: '40 минут на машину, по лоткам или через насос. Водитель звонит за 30 минут.' },
];
---
<Block id="H-06" name="Как проходит заказ">
  <Container class="py-12 md:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="text-xl md:text-2xl font-semibold tracking-tight">Как проходит заказ</h2>
      <p class="rounded-md border border-line bg-white px-3 py-1.5 text-sm">
        Заявка до {site.orderDeadline}, бетон сегодня
      </p>
    </div>
    <ol class="mt-6 grid gap-3 md:grid-cols-4">
      {steps.map((s, i) => (
        <li class="rounded-md border border-line bg-white p-4">
          <span class="grid size-7 place-items-center rounded-full border border-line text-xs">{i + 1}</span>
          <div class="mt-3 font-medium">{s.title}</div>
          <p class="mt-1 text-sm text-ink-2">{s.text}</p>
        </li>
      ))}
    </ol>
  </Container>
</Block>
