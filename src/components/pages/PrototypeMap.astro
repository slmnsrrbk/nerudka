---
import PageHead from '../ui/PageHead.astro';
import Block from '../ui/Block.astro';
import Container from '../ui/Container.astro';
import { routeGroups, TEMPLATES } from '../../lib/routes';
import { products } from '../../lib/catalog';
import { geoPoints } from '../../lib/geo';

const groups = routeGroups();
const total = groups.reduce((acc, g) => acc + g.routes.length, 0);
---
<PageHead
    h1="Карта прототипа"
    lead="Служебная страница для передачи в дизайн и обсуждения с заказчиком. В индекс не отдаётся, из карты сайта исключена."
  />

  <Block id="M-01" name="Статистика">
    <Container class="py-10">
      <div class="grid gap-3 md:grid-cols-4">
        <div class="rounded-md border border-line bg-white p-4"><div class="text-2xl font-semibold">{total}</div><div class="mt-1 text-xs text-ink-2">страниц в прототипе</div></div>
        <div class="rounded-md border border-line bg-white p-4"><div class="text-2xl font-semibold">{TEMPLATES.length}</div><div class="mt-1 text-xs text-ink-2">уникальных шаблонов</div></div>
        <div class="rounded-md border border-line bg-white p-4"><div class="text-2xl font-semibold">{products.length}</div><div class="mt-1 text-xs text-ink-2">позиций в каталоге</div></div>
        <div class="rounded-md border border-line bg-white p-4"><div class="text-2xl font-semibold">{geoPoints.length}</div><div class="mt-1 text-xs text-ink-2">гео-направлений</div></div>
      </div>
      <p class="mt-4 text-sm text-ink-2">
        Добавление позиции в products.json создаёт карточку, строку в категории, попадание в посадки марки, класса и задач, строку в прайсе.
        Добавление пункта в geo.json создаёт гео-страницу и строку в списке на странице доставки.
      </p>
    </Container>
  </Block>

  <Block id="M-02" name="Шаблоны" tone="block">
    <Container class="py-12">
      <h2 class="text-xl font-semibold tracking-tight">Шаблоны</h2>
      <div class="table-scroll mt-4 rounded-md border border-line bg-white">
        <table class="w-full min-w-[560px] text-sm">
          <thead class="bg-block text-left text-xs text-ink-2">
            <tr><th class="px-4 py-3 font-medium">ID</th><th class="px-4 py-3 font-medium">Название</th><th class="px-4 py-3 font-medium">Пример страницы</th></tr>
          </thead>
          <tbody class="divide-y divide-line">
            {TEMPLATES.map((t) => (
              <tr>
                <td class="px-4 py-3 font-medium">{t.id}</td>
                <td class="px-4 py-3">{t.name}</td>
                <td class="px-4 py-3"><a href={t.example} class="text-accent underline-offset-2 hover:underline">{t.example}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Container>
  </Block>

  <Block id="M-03" name="Все URL">
    <Container class="py-12">
      <h2 class="text-xl font-semibold tracking-tight">Все страницы</h2>
      <div class="mt-6 grid gap-6">
        {groups.map((g) => (
          <section class="rounded-md border border-line bg-white p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-medium">{g.title}</h3>
              <span class="text-xs text-ink-2">{g.template}, страниц: {g.routes.length}</span>
            </div>
            <ul class="mt-3 grid gap-1 md:grid-cols-2">
              {g.routes.map((r) => (
                <li class="text-sm">
                  <a href={r.href} class="text-accent underline-offset-2 hover:underline">{r.href}</a>
                  <span class="text-ink-2"> {r.label}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </Container>
  </Block>
