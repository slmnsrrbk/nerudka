---
import LeadForm from '../forms/LeadForm.astro';
import { products } from '../../lib/catalog';
import site from '../../data/site.json';
const zones = site.deliveryZones;
const inputCls = 'w-full rounded-md border border-line bg-white px-3 py-2.5 text-[15px] outline-none focus:border-accent';
---
<!-- Модалка: обратный звонок -->
<div data-modal="callback" class="fixed inset-0 z-[90] hidden items-center justify-center p-4">
  <div data-modal-close class="absolute inset-0 bg-ink/50"></div>
  <div class="relative w-full max-w-md rounded-md border border-line bg-white p-5 shadow-lg">
    <button type="button" data-modal-close aria-label="Закрыть" class="absolute right-3 top-3 text-ink-2 hover:text-ink">×</button>
    <h3 class="mb-1 text-lg font-semibold">Обратный звонок</h3>
    <p class="mb-4 text-sm text-ink-2">Перезвоним в течение 15 минут в рабочем сценарии.</p>
    <LeadForm variant="compact" class="border-0 p-0" />
  </div>
</div>

<!-- Модалка: быстрая заявка и заказ продукта (поля предзаполняются) -->
<div data-modal="order" class="fixed inset-0 z-[90] hidden items-center justify-center p-4">
  <div data-modal-close class="absolute inset-0 bg-ink/50"></div>
  <div class="relative w-full max-w-md rounded-md border border-line bg-white p-5 shadow-lg">
    <button type="button" data-modal-close aria-label="Закрыть" class="absolute right-3 top-3 text-ink-2 hover:text-ink">×</button>
    <h3 class="mb-1 text-lg font-semibold" data-modal-title>Заказ бетона</h3>
    <p class="mb-4 text-sm text-ink-2">Уточним время подачи и условия подъезда, затем пришлём счёт.</p>
    <form data-form class="grid gap-3">
      <label class="grid gap-1.5">
        <span class="text-xs text-ink-2">Телефон</span>
        <input type="tel" name="phone" placeholder="+7 (___) ___-__-__" class={inputCls} required />
      </label>
      <label class="grid gap-1.5">
        <span class="text-xs text-ink-2">Марка</span>
        <select name="product" data-modal-product class={inputCls}>
          {products.map((p) => <option value={p.id}>{p.name}</option>)}
        </select>
      </label>
      <div class="grid gap-3 md:grid-cols-2">
        <label class="grid gap-1.5">
          <span class="text-xs text-ink-2">Объём, м³</span>
          <input type="number" name="volume" min={site.minVolume} value="10" data-modal-volume class={inputCls} />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs text-ink-2">Зона доставки</span>
          <select name="zone" data-modal-zone class={inputCls}>
            {zones.map((z) => <option value={z.id}>{z.name}</option>)}
          </select>
        </label>
      </div>
      <label class="mt-1 flex items-start gap-2 text-xs text-ink-2">
        <input type="checkbox" data-consent class="mt-0.5 size-4 shrink-0 accent-[#2563EB]" />
        <span>Согласен на обработку персональных данных, <a href="/soglasie/" class="text-accent underline-offset-2 hover:underline">текст согласия</a></span>
      </label>
      <button type="submit" data-submit disabled class="mt-1 w-full rounded-md border border-accent bg-accent px-5 py-3 text-[15px] font-medium text-accent-ink transition-colors hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-40">
        Отправить заявку
      </button>
    </form>
  </div>
</div>

<!-- Панель «Список заявки» -->
<div data-request-panel class="fixed inset-0 z-[95] hidden items-stretch justify-end">
  <div data-request-close class="absolute inset-0 bg-ink/50"></div>
  <div class="relative flex h-full w-full max-w-md flex-col border-l border-line bg-white">
    <div class="flex items-center justify-between border-b border-line p-4">
      <h3 class="text-lg font-semibold">Список заявки</h3>
      <button type="button" data-request-close aria-label="Закрыть" class="text-ink-2 hover:text-ink">×</button>
    </div>
    <div data-request-items class="flex-1 overflow-y-auto p-4 text-sm"></div>
    <div class="border-t border-line p-4">
      <div class="mb-3 flex items-center justify-between text-sm">
        <span class="text-ink-2">Итого без доставки</span>
        <b data-request-total>0 ₽</b>
      </div>
      <LeadForm variant="compact" submitLabel="Отправить список" class="border-0 p-0" />
    </div>
  </div>
</div>

<!-- Плавающая кнопка списка заявки -->
<button type="button" data-request-open class="fixed bottom-20 right-4 z-[80] hidden items-center gap-2 rounded-full border border-line bg-white px-4 py-3 text-sm font-medium shadow-lg md:bottom-6">
  Заявка (<span data-request-count>0</span>)
</button>

<!-- Тост -->
<div data-toast class="pointer-events-none fixed left-1/2 top-4 z-[100] hidden -translate-x-1/2 rounded-md border border-line bg-white px-4 py-3 text-sm shadow-lg"></div>
