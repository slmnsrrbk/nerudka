---
// Политика конфиденциальности (обработка персональных данных по 152-ФЗ) в дизайне «3».
// Типовой текст-шаблон: реквизиты оператора и сроки — [заглушка], перед запуском текст проверяет юрист.
import HomeLayout from '../../layouts/HomeLayout.astro';
import PageHero from '../../components/site/PageHero.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { site } from '../../lib/home-site';

const sections: [string, string[]][] = [
  ['1. Общие положения', [
    `Политика описывает, как ${site.name} (далее — Оператор) обрабатывает и защищает персональные данные посетителей сайта. Документ составлен в соответствии с Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных».`,
    'Оператор: [заглушка: полное наименование юрлица, ИНН, ОГРН, юридический адрес].',
    'Отправляя форму на сайте и отмечая согласие, пользователь подтверждает, что ознакомился с Политикой и согласен с ней.',
  ]],
  ['2. Какие данные обрабатываются', [
    'Имя, номер телефона, адрес электронной почты, адрес объекта и комментарий к заявке — то, что пользователь сам указывает в формах.',
    'Технические данные: cookie, IP-адрес, сведения о браузере и устройстве, страницы сайта, которые открывал пользователь.',
  ]],
  ['3. Цели обработки', [
    'Ответить на заявку, рассчитать стоимость, оформить и выполнить заказ, связаться по вопросам поставки.',
    'Отправить документы по заказу и выполнить обязанности по договору.',
    'Улучшать работу сайта по обезличенной статистике посещений.',
  ]],
  ['4. Правовые основания', [
    'Согласие пользователя на обработку персональных данных, договор с пользователем и обязанности Оператора, установленные законом.',
  ]],
  ['5. Порядок и сроки обработки', [
    'Данные обрабатываются с использованием средств автоматизации и без них: сбор, запись, систематизация, хранение, уточнение, использование, удаление.',
    'Данные хранятся не дольше, чем этого требуют цели обработки: [заглушка: срок хранения]. После достижения целей или отзыва согласия данные удаляются, если закон не требует их хранить.',
    'Оператор не передаёт данные третьим лицам, кроме случаев, предусмотренных законом, и подрядчиков, которые участвуют в выполнении заказа, например перевозчика, — в объёме, нужном для доставки.',
  ]],
  ['6. Защита данных', [
    'Оператор принимает правовые, организационные и технические меры, чтобы защитить данные от неправомерного доступа, изменения, распространения и уничтожения.',
  ]],
  ['7. Права пользователя', [
    'Пользователь может получить сведения об обработке своих данных, потребовать уточнить, заблокировать или удалить их, а также отозвать согласие.',
    `Для этого достаточно написать на ${site.email} или позвонить по номеру ${site.phone}. Срок ответа — в пределах, установленных законом.`,
  ]],
  ['8. Cookie', [
    'Сайт использует cookie и локальное хранилище браузера, чтобы работала корзина и запоминались настройки. Отключить cookie можно в настройках браузера, но часть функций сайта может перестать работать.',
  ]],
  ['9. Изменение Политики', [
    'Оператор может обновлять Политику. Действующая редакция всегда опубликована на этой странице. Дата редакции: [заглушка].',
  ]],
];
---
<HomeLayout title="Политика конфиденциальности" description="Как мы обрабатываем и защищаем персональные данные посетителей сайта: какие данные, зачем, как долго храним и как отозвать согласие.">
  <PageHero h1="Политика конфиденциальности" sub="Обработка персональных данных посетителей сайта" crumbs={[{ href: '/', label: 'Главная' }, { label: 'Политика конфиденциальности' }]} />
  <section class="sec sec-first" aria-label="Текст политики">
    <div class="wrap">
      <article class="card-w prose-d policy">
        {sections.map(([h, ps]) => (
          <section>
            <h2 class="h3">{h}</h2>
            {ps.map((t) => <p>{t}</p>)}
          </section>
        ))}
      </article>
    </div>
  </section>
  <div class="sec-end"></div>
  <SiteFooter slot="footer" />
</HomeLayout>
