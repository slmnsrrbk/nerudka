---
// Список позиций строками (страницы марки, класса, назначения): название и характеристики, цена, счётчик с корзиной, «Подробнее».
// У строки — данные для фильтров (data-f-*), чтобы панель фильтров скрывала лишнее без перезагрузки.
import Icon from '../home/Icon.astro';
import { productPath, specLine, fmt, type RowGroup } from '../../lib/inner';
interface Props { groups: RowGroup[]; heads?: boolean }
const { groups, heads = groups.length > 1 } = Astro.props;
const fill = (f: string) => (f ? ` · ${f}` : '');
---
<div class="prlist" data-frows>
  {groups.map((g) => (
    <div class="pgroup" data-fgroup>
      {heads && g.title && <p class="prlist-h">{g.href ? <a href={g.href}>{g.title}</a> : g.title}</p>}
      <div class="prows">
        {g.items.map((p) => {
          const href = productPath(p);
          return (
            <div class="prow" data-frow data-f-grade={p.grade} data-f-filler={p.filler} data-f-mob={p.mobility} data-f-frost={p.frost} data-f-water={p.water} data-f-price={p.price}>
              <div class="prow-name"><a href={href}>{p.name}</a><span>{specLine(p).split(' · ').slice(0, 2).join(' · ')}{fill(p.filler)}</span></div>
              <div class="pcell" data-item={p.id} data-name={p.name} data-price={p.price} data-href={href}>
                <span class="pcell-l">Цена за м³</span>
                <b class="pcell-p">{fmt(p.price)} ₽</b>
                <div class="pact">
                  <div class="stepper">
                    <button type="button" class="st-b" data-dec aria-label="Меньше"><Icon name="minus" size={14} /></button>
                    <input class="st-q" value="1" inputmode="decimal" data-qty aria-label="Объём, м³" />
                    <button type="button" class="st-b" data-inc aria-label="Больше"><Icon name="plus" size={14} /></button>
                    <button type="button" class="st-cart" data-add aria-label={`Добавить в корзину: ${p.name}`}><Icon name="shopping-cart" size={16} /></button>
                  </div>
                  <a class="more" href={href}>Подробнее<Icon name="arrow-right" size={16} /></a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  ))}
  <p class="prlist-empty" data-fempty hidden>Под фильтры ничего не подошло. Сбросьте фильтры или позвоните — подберём состав.</p>
</div>
