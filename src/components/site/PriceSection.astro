---
// Прайс-лист в дизайне «3» (Figma «Вариант · 02 · Прайс-лист — вкладка с одной ценой» 275:12961):
// адреса РБУ, все виды продукции слева, позиции справа, счётчик и «в корзину».
// Один блок для главной, /price/ и всех страниц каталога:
//  - главная и /price/ (links = false): виды слева переключают вкладки без перезагрузки;
//  - каталог (links = true): виды слева — ссылки на страницы видов, справа — позиции текущей страницы (panes),
//    под видами — фильтры по параметрам позиций (заполнитель, плотность, подвижность, F, W).
import Icon from '../home/Icon.astro';
import SectionHead from '../home/SectionHead.astro';
import { priceTabs, rub, PLANTS, fmt, plural, type PriceTab } from '../../lib/home';
interface Props { head?: boolean; links?: boolean; active?: string; panes?: PriceTab[]; title?: { name: string; note: string }; filters?: boolean }
const { head = true, links = false, active = 'tovarnyj', panes, title, filters = links } = Astro.props;
const tabs = priceTabs();
const betonTabs = tabs.filter((t) => t.group === 'beton');
const mortarTabs = tabs.filter((t) => t.group === 'rastvor');
const totalItems = tabs.reduce((s, t) => s + t.count, 0);
const shown = panes ?? tabs;
const many = links && shown.length > 1;
const activeName = tabs.find((t) => t.slug === active)?.name ?? title?.name ?? 'Все виды';
const groupHref = { 'Бетон': '/catalog/beton/', 'Растворы и смеси': '/catalog/rastvor/' } as Record<string, string>;

// Фильтры: только параметры, у которых на странице больше одного значения.
const FGROUPS: [string, string][] = [['filler', 'Заполнитель'], ['density', 'Плотность'], ['mob', 'Подвижность'], ['frost', 'Морозостойкость'], ['water', 'Водонепроницаемость']];
const num = (v: string) => parseFloat(v.replace(/\D+/g, '')) || 0;
const fvals = new Map<string, Set<string>>();
for (const t of shown) for (const r of t.rows) for (const kv of (r.f ?? '').split('|').filter(Boolean)) {
  const [k, v] = kv.split(':');
  if (k === 'filler' && t.columns.length > 1) continue; // гравий и гранит уже разнесены по колонкам
  if (!fvals.has(k)) fvals.set(k, new Set());
  fvals.get(k)!.add(v);
}
const fgroups = filters ? FGROUPS.map(([k, label]) => ({ k, label, vals: [...(fvals.get(k) ?? [])].sort((a, b) => num(a) - num(b) || a.localeCompare(b)) })).filter((g) => g.vals.length > 1) : [];
const sumLabel = fgroups.map((g) => g.label).join(', ');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const total = shown.reduce((s, t) => s + t.count, 0);
---
<section class:list={['sec', { 'sec-first': !head }]} id="price" aria-labelledby={head ? 'price-h' : undefined} aria-label={head ? undefined : 'Прайс-лист'}>
  <div class="wrap">
    {head && <SectionHead id="price-h" label="Прайс" title="Прайс-лист" sub="все виды бетона и растворов" desc="Цены за 1 м³ с завода, на условиях самовывоза. Прайс единый для всех шести РБУ — отгружаем с ближайшего к объекту." />}
    <div class="stack">
      <div class="card addr-card">
        <div class="addr-t">
          <h3 class="h3">Адреса производств</h3>
          <p class="muted">Один прайс на все шесть РБУ. Заявка уходит на ближайший к объекту узел.</p>
        </div>
        <ul class="addr-grid">
          {PLANTS.map((p) => (
            <li class="addr"><span class="tile"><Icon name="map-pin" /></span><span><b>РБУ {p.n}</b><span class="muted">{p.address}</span></span></li>
          ))}
        </ul>
      </div>
      <div class:list={['price', { 'price-links': links }]} data-price data-price-mode={links ? 'links' : 'tabs'}>
        <div class="price-side">
          <!-- Телефон: вместо списка видов — кнопка-фильтр, список открывается во всплывающем окне снизу. -->
          <button type="button" class="card price-pick" data-price-pick aria-haspopup="dialog">
            <span class="price-pick-t"><span class="small muted">Вид продукции · {tabs.length} видов</span><b data-price-pick-v>{activeName}</b></span>
            <span class="price-pick-ic"><Icon name="chevron-down" size={20} /></span>
          </button>
          <aside class="card price-nav">
            <div class="price-nav-h"><h3 class="h3">Все виды продукции</h3><p class="small muted">{tabs.length} видов · {totalItems} позиций</p></div>
            {[['Бетон', betonTabs], ['Растворы и смеси', mortarTabs]].map(([gt, list]) => (
              <div class="price-nav-g">
                <p class="kicker">{gt as string} · {(list as typeof tabs).length} видов</p>
                {links ? (
                  <nav class="price-nav-list" aria-label={gt as string}>
                    <a class:list={['kind', 'kind-all', { on: active === groupHref[gt as string] }]} href={groupHref[gt as string]} aria-current={active === groupHref[gt as string] ? 'page' : undefined}><span>Все виды</span><Icon name="arrow-right" size={14} /></a>
                    {(list as typeof tabs).map((t) => (
                      <a class:list={['kind', { on: t.slug === active }]} href={t.href} aria-current={t.slug === active ? 'page' : undefined}><span>{t.name}</span><span class="kind-p">от {fmt(t.min)} ₽</span></a>
                    ))}
                  </nav>
                ) : (
                  <div class="price-nav-list" role="tablist" aria-label={gt as string}>
                    {(list as typeof tabs).map((t) => (
                      <button type="button" role="tab" class:list={['kind', { on: t.slug === active }]} aria-selected={t.slug === active ? 'true' : 'false'} data-price-tab={t.slug}>
                        <span>{t.name}</span><span class="kind-p">от {fmt(t.min)} ₽</span>
                      </button>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </aside>
          {fgroups.length > 0 && (
            <button type="button" class="card price-pick pf-open" data-pf-open aria-haspopup="dialog">
              <span class="price-pick-t"><span class="small muted">Фильтры</span><b data-pf-sum data-pf-default={sumLabel}>{sumLabel}</b></span>
              <span class="price-pick-ic"><Icon name="sliders" size={20} /></span>
            </button>
          )}
          {fgroups.length > 0 && <div class="pf-back" data-pf-close hidden></div>}
          {fgroups.length > 0 && (
            <form class="card price-nav price-filter" data-pfilter aria-label="Фильтры" onsubmit="return false">
              <div class="price-filter-h"><h3 class="h3">Фильтры</h3><button type="reset" class="pf-reset" data-pf-reset hidden>Сбросить</button></div>
              {fgroups.map((g) => (
                <fieldset class="price-nav-g pf-g">
                  <legend class="kicker">{g.label}</legend>
                  <div class="pf-list">
                    {g.vals.map((v) => (
                      <label class="kind pf-i"><input type="checkbox" name={g.k} value={v} /><span>{g.k === 'filler' ? cap(v) : v}</span><span class="pf-box" aria-hidden="true"><Icon name="check" size={14} stroke={2.5} /></span></label>
                    ))}
                  </div>
                </fieldset>
              ))}
              <button type="button" class="btn btn-dark btn-block pf-done" data-pf-close>Показать позиции</button>
            </form>
          )}
        </div>
        <div class="card price-panel">
          <div class="price-top">
            {many && title && (
              <div class="ptab-h ptab-h-top"><div><h3 class="h3 h3-l">{title.name}</h3><p class="small muted" data-pf-count data-total={total}>{title.note}</p></div></div>
            )}
            {shown.map((t, ti) => (
              <div class:list={['ptab', { 'ptab-sub': many }]} data-price-pane={t.slug} role={links ? undefined : 'tabpanel'} hidden={!links && t.slug !== active}>
                <div class="ptab-h">
                  {many
                    ? <div><h4 class="h3"><a href={t.href}>{t.name}</a></h4><p class="small muted">{t.note}</p></div>
                    : <div><h3 class="h3 h3-l">{t.name}</h3><p class="small muted" data-pf-count={links && ti === 0 ? '' : undefined} data-total={t.count}>{t.note}</p></div>}
                </div>
                <div class:list={['prow', 'prow-head', { two: t.columns.length > 1 }]}>
                  <span>Марка</span>{t.columns.map((c) => <span>{c}</span>)}
                </div>
                <div class="prows">
                  {t.rows.map((r) => (
                    <div class:list={['prow', { two: t.columns.length > 1 }]} data-f={r.f}>
                      <div class="prow-name"><a href={(r.cells.find(Boolean))!.href}>{r.title}</a><span>{r.sub}</span></div>
                      {r.cells.map((c, i) => c ? (
                        <div class="pcell" data-item={c.id} data-name={c.name} data-price={c.price} data-href={c.href}>
                          <span class="pcell-l">{t.columns[i].replace(' · за м³', '')}</span>
                          <b class="pcell-p">{rub(c.price)}</b>
                          <div class="pact">
                            <div class="stepper">
                              <button type="button" class="st-b" data-dec aria-label="Меньше"><Icon name="minus" size={14} /></button>
                              <input class="st-q" value="1" inputmode="decimal" data-qty aria-label="Объём, м³" />
                              <button type="button" class="st-b" data-inc aria-label="Больше"><Icon name="plus" size={14} /></button>
                              <button type="button" class="st-cart" data-add aria-label={`Добавить в корзину: ${c.name}`}><Icon name="shopping-cart" size={16} /></button>
                            </div>
                            <a class="more" href={c.href}>Подробнее<Icon name="arrow-right" size={16} /></a>
                          </div>
                        </div>
                      ) : (
                        <div class="pcell pcell-none"><span class="pcell-l">{t.columns[i].replace(' · за м³', '')}</span><b class="pcell-p">—</b></div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            ))}
            {fgroups.length > 0 && <p class="pf-empty card-w" data-pf-empty hidden>По выбранным параметрам позиций нет. <button type="button" class="ulink" data-pf-reset>Сбросить фильтры</button></p>}
            <div class="strip">
              <span class="tile tile-grey"><Icon name="percent" /></span>
              <div><p class="strip-t">От 50 м³ — скидка 10 %, от 200 м³ — 15 %, от 500 м³ — 20 %</p><p class="small muted">Скидку учтём в расчёте цены и в корзине</p></div>
            </div>
            <div>{head || links
              ? <a class="btn btn-dark" href="/price/">{links ? 'Весь прайс-лист' : 'Скачать прайс PDF'}<Icon name={links ? 'arrow-right' : 'download'} size={16} /></a>
              : <button type="button" class="btn btn-dark" data-print>Скачать прайс PDF<Icon name="download" size={16} /></button>}</div>
          </div>
          <div class="banner">
            <div class="banner-t"><p class="banner-h">Не нашли нужную марку?</p><p>Подберём состав под вашу задачу и пришлём расчёт — выберите вид продукции слева или напишите нам.</p></div>
            <button type="button" class="btn btn-light" data-modal="lead" data-topic="Подбор марки">Заказать консультацию<Icon name="arrow-right" size={16} /></button>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="ov" data-overlay="price-kinds" hidden role="dialog" aria-modal="true" aria-labelledby="pk-title">
    <div class="ov-card pk-card">
      <button type="button" class="ov-x" data-close aria-label="Закрыть"><Icon name="x" size={20} /></button>
      <p class="ov-title" id="pk-title">Вид продукции</p>
      {[['Бетон', betonTabs], ['Растворы и смеси', mortarTabs]].map(([gt, list]) => (
        <div class="pk-g">
          <p class="kicker">{gt as string} · {(list as typeof tabs).length} видов</p>
          <div class="pk-list">
            {links && <a class:list={['pk-i', { on: active === groupHref[gt as string] }]} href={groupHref[gt as string]}><span>Все виды</span><Icon name="check" size={16} class="pk-tick" /></a>}
            {(list as typeof tabs).map((t) => links ? (
              <a class:list={['pk-i', { on: t.slug === active }]} href={t.href}><span>{t.name}</span><span class="kind-p">от {fmt(t.min)} ₽</span><Icon name="check" size={16} class="pk-tick" /></a>
            ) : (
              <button type="button" class:list={['pk-i', { on: t.slug === active }]} data-pick-kind={t.slug} aria-pressed={t.slug === active ? 'true' : 'false'}>
                <span>{t.name}</span><span class="kind-p">от {fmt(t.min)} ₽</span><Icon name="check" size={16} class="pk-tick" />
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
