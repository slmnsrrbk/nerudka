---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Block from '../../components/ui/Block.astro';
import Container from '../../components/ui/Container.astro';
import FaqBlock from '../../components/blocks/FaqBlock.astro';
import CtaFinal from '../../components/blocks/CtaFinal.astro';
import { geoPoints, geoByGroup, geoPath, GEO_GROUPS } from '../../lib/geo';
import { formatPrice } from '../../lib/price';
import site from '../../data/site.json';

const facts = [
  { t: `Заявка до ${site.orderDeadline}`, d: 'обычно отгружаем в тот же день' },
  { t: `От ${site.minVolume} м³`, d: 'работаем и с частными заказчиками' },
  { t: 'Круглосуточно', d: 'ночные отгрузки без наценки' },
];
const requirements = [
  'Ширина проезда от 3,5 метров, высота без ограничений от 4 метров',
  'Площадка с твёрдым основанием: полная масса миксера до 32 тонн',
  `Бесплатное время выгрузки: ${site.unloadFreeMin} минут на машину`,
  `Простой сверх лимита: ${formatPrice(site.idleRate)} ₽ в час`,
  'Место для мойки лотка или согласие на мойку за пределами участка',
];
---
<BaseLayout
  title="Доставка бетона по Москве и области: зоны, цены, сроки"
  description="Зоны доставки, цена за м³, требования к подъезду и время выгрузки. Список направлений: Москва по округам, Новая Москва, Московская область."
  template="T07a"
  templateName="Доставка"
>
  <Breadcrumbs items={[{ label: 'Доставка' }]} />
  <PageHead id="D-01" name="H1 доставки" h1="Доставка бетона" lead="Возим миксерами от 5 до 12 м³ по Москве, Новой Москве и области. Цена доставки зависит от зоны, она видна до оформления заказа.">
    <div class="mt-6 grid gap-3 md:grid-cols-3">
      {facts.map((f) => (
        <div class="rounded-md border border-line bg-white p-4">
          <div class="font-medium">{f.t}</div>
          <div class="mt-1 text-sm text-ink-2">{f.d}</div>
        </div>
      ))}
    </div>
  </PageHead>

  <Block id="D-02" name="Карта зон">
    <Container class="grid gap-4 py-12 lg:grid-cols-[1.3fr_0.7fr]">
      <div class="ph rounded-md" style="padding-top:56%">
        <span class="absolute inset-0 grid place-items-center text-center text-xs text-ink-2">Карта: четыре зоны доставки вокруг завода · 16:9</span>
      </div>
      <ul class="grid content-start gap-2">
        {site.deliveryZones.map((z, i) => (
          <li class="flex items-center justify-between gap-3 rounded-md border border-line bg-white p-4">
            <span class="flex items-center gap-3">
              <span class="ph size-6 rounded-full"></span>
              <span>Зона {i + 1}: {z.name}</span>
            </span>
            <b>{formatPrice(z.pricePerM3)} ₽ за м³</b>
          </li>
        ))}
      </ul>
    </Container>
  </Block>

  <Block id="D-03" name="Таблица цены по км" tone="block">
    <Container class="py-12">
      <h2 class="text-xl font-semibold tracking-tight">Сколько стоит доставка</h2>
      <div class="table-scroll mt-4 rounded-md border border-line bg-white">
        <table class="w-full min-w-[520px] text-sm">
          <thead class="bg-block text-left text-xs text-ink-2">
            <tr><th class="px-4 py-3 font-medium">Расстояние от завода</th><th class="px-4 py-3 font-medium">Цена за м³</th><th class="px-4 py-3 font-medium">Пример: 8 м³</th></tr>
          </thead>
          <tbody class="divide-y divide-line">
            {site.deliveryZones.map((z) => (
              <tr>
                <td class="px-4 py-3">{z.name}</td>
                <td class="px-4 py-3">{formatPrice(z.pricePerM3)} ₽</td>
                <td class="px-4 py-3 text-ink-2">{formatPrice(z.pricePerM3 * 8)} ₽ за рейс</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-ink-2">Дальше 50 км считаем индивидуально: {formatPrice(site.deliveryKmPrice)} ₽ за км сверх зоны.</p>
    </Container>
  </Block>

  <Block id="D-04" name="Поиск населённого пункта">
    <Container class="py-8">
      <label class="grid max-w-lg gap-1.5">
        <span class="text-xs text-ink-2">Найдите свой населённый пункт</span>
        <input type="search" placeholder="например, Подольск" data-filter-input="[data-geo-item]"
          class="w-full rounded-md border border-line bg-white px-3 py-2.5 text-[15px] outline-none focus:border-accent" />
      </label>
    </Container>
  </Block>

  <Block id="D-05" name="Список направлений" tone="block">
    <Container class="py-12">
      <h2 class="text-xl font-semibold tracking-tight">Куда возим: {geoPoints.length} направлений</h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-3">
        {GEO_GROUPS.map((group) => (
          <div data-filter-group>
            <h3 class="text-sm text-ink-2">{group.title}</h3>
            <ul class="mt-3 grid gap-2">
              {geoByGroup(group.id).map((g) => (
                <li data-geo-item data-search-text={`${g.name} ${g.namePrep}`.toLowerCase()}>
                  <a href={geoPath(g.slug)} class="flex items-center justify-between gap-3 rounded-md border border-line bg-white px-4 py-2.5 text-sm hover:border-accent">
                    <span>{g.name}{g.okrug ? `, ${g.okrug}` : ''}</span>
                    <span class="text-xs text-ink-2">{g.distanceKm} км</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Container>
  </Block>

  <Block id="D-06" name="Требования к подъезду">
    <Container class="py-12">
      <h2 class="text-xl font-semibold tracking-tight">Требования к подъезду и выгрузке</h2>
      <ul class="mt-4 grid gap-2 md:grid-cols-2">
        {requirements.map((r) => <li class="rounded-md border border-line bg-white p-3 text-sm">{r}</li>)}
      </ul>
    </Container>
  </Block>

  <FaqBlock id="D-07" scope="delivery" title="Вопросы по доставке" limit={5} />
  <CtaFinal id="D-08" title="Узнать стоимость доставки на ваш адрес" />
</BaseLayout>
