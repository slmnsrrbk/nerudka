---
import Block from '../ui/Block.astro';
import Container from '../ui/Container.astro';
import Btn from '../ui/Btn.astro';
import LeadForm from '../forms/LeadForm.astro';
import site from '../../data/site.json';

interface Props {
  id?: string;
  title?: string;
  text?: string;
  variant?: 'default' | 'kp';
  hero?: boolean;
}
const {
  id = 'X-06',
  title = 'Рассчитаем бетон под ваш объект за 5 минут',
  text = 'Оставьте телефон, уточним марку, объём и адрес, затем пришлём расчёт с доставкой.',
  variant = 'default',
  hero = false,
} = Astro.props;
---
<Block id={id} name="Финальный CTA">
  <Container class="py-12 md:py-20">
    <div class="grid gap-8 rounded-md border border-line bg-white p-6 md:grid-cols-2 md:p-10">
      <div>
        {hero && (
          <div class="ph mb-6 rounded-md" style="padding-top:42.8%">
            <span class="absolute inset-0 flex items-center justify-center text-xs text-ink-2">Фон: тёмное фото стройплощадки · 21:9</span>
          </div>
        )}
        <h2 class="text-xl md:text-2xl font-semibold tracking-tight">{title}</h2>
        <p class="mt-3 text-ink-2">{text}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          <Btn href={`tel:${site.phoneHref}`} variant="secondary">{site.phone}</Btn>
          <Btn href={site.messengers.telegram} variant="ghost">Telegram</Btn>
          <Btn href={site.messengers.whatsapp} variant="ghost">WhatsApp</Btn>
          <Btn href={site.messengers.max} variant="ghost">MAX</Btn>
        </div>
      </div>
      <LeadForm variant={variant} />
    </div>
  </Container>
</Block>
