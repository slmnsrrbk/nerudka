---
import Block from '../ui/Block.astro';
import Container from '../ui/Container.astro';
import { purposes, productsByPurpose, minPrice } from '../../lib/catalog';
import { formatPrice } from '../../lib/price';

interface Props { id?: string; title?: string; tone?: 'page' | 'block' }
const { id = 'H-04', title = 'Подбор по задаче', tone = 'page' } = Astro.props;
---
<Block id={id} name="Подбор по задаче" tone={tone}>
  <Container class="py-12 md:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="text-xl md:text-2xl font-semibold tracking-tight">{title}</h2>
      <p class="text-sm text-ink-2">Второй вход в каталог: не по марке, а по конструкции</p>
    </div>
    <div class="mt-6 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
      {purposes.map((p) => {
        const items = productsByPurpose(p.slug);
        return (
          <a href={`/beton/dlya-${p.slug}/`} class="rounded-md border border-line bg-white p-4 transition-colors hover:border-accent">
            <div class="text-base font-medium">{p.h1}</div>
            <div class="mt-1 text-sm text-ink-2">{p.short}</div>
            <div class="mt-3 flex items-center justify-between text-sm">
              <span class="rounded-md border border-line px-2 py-1 text-xs">рекомендуем {p.recommended}</span>
              <span class="text-ink-2">от {formatPrice(minPrice(items))} ₽ за м³</span>
            </div>
          </a>
        );
      })}
    </div>
  </Container>
</Block>
