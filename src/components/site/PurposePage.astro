---
// Подкатегория «назначение» (Figma «Подкатегория · назначение · Бетон для фундамента»): шапка с формой, соседние назначения,
// какая марка нужна, позиции с фильтрами, калькулятор, что указать в заявке, советы, доставка, популярное, вопросы, облако, SEO.
import PageHero from './PageHero.astro';
import PriceSection from './PriceSection.astro';
import { tabsForItems } from '../../lib/home';
import CalcSection from './CalcSection.astro';
import DeliveryZones from './DeliveryZones.astro';
import PopularBlock from './PopularBlock.astro';
import FaqSection from './FaqSection.astro';
import LinkCloud from './LinkCloud.astro';
import SeoSection from './SeoSection.astro';
import SectionHead from '../home/SectionHead.astro';
import Icon from '../home/Icon.astro';
import { products, purposes, fmt, plural, purposeHref, purposeLabel, minPrice, img, byGrade, CATALOG_SUB } from '../../lib/inner';
import { productsByPurpose } from '../../lib/catalog';
import TipCards from './TipCards.astro';
import type { Purpose } from '../../lib/types';
interface Props { purpose: Purpose }
const { purpose } = Astro.props;
const items = productsByPurpose(purpose.slug).sort(byGrade);
const FAMILY = [['fundament', 'lentochnyj-fundament', 'plitnyj-fundament'], ['styazhka', 'otmostka', 'garazh']];
const fam = FAMILY.find((f) => f.includes(purpose.slug)) ?? [purpose.slug, ...purposes.filter((p) => p.slug !== purpose.slug).slice(0, 2).map((p) => p.slug)];
const cards = [purpose.slug, ...fam.filter((s) => s !== purpose.slug)].map((s) => purposes.find((p) => p.slug === s)!).filter(Boolean);
const rec = products.find((p) => p.category === 'tovarnyj' && p.grade === purpose.recommended && p.filler === 'гравий') ?? items[0];
const crumbs = [{ href: '/', label: 'Главная' }, { href: '/catalog/', label: 'Каталог' }, { label: purposeLabel(purpose.h1) }];
const formItems = items.map((p) => ({ id: p.id, label: p.name.replace('Бетон ', '') }));
const ask = [
  rec && `Марку и класс: ${rec.grade} ${rec.class}`,
  rec?.mobility && `Подвижность: ${rec.mobility}`,
  rec && [rec.frost, rec.water].filter(Boolean).length && `Морозостойкость и водонепроницаемость: ${[rec.frost, rec.water].filter(Boolean).join(', ')}`,
  'Заполнитель: гравий или гранит', 'Объём с запасом 5 %', 'Адрес и подъезд для миксера', 'Дату и время подачи', 'Нужен ли бетононасос',
].filter(Boolean) as string[];
---
<PageHero h1={purpose.h1} sub={CATALOG_SUB} crumbs={crumbs} form formSelected={rec?.id} formOptions={formItems} formTopic={`Расчёт цены: ${purpose.h1}`} />
<PriceSection head={false} links active="" panes={tabsForItems(items)} title={{ name: purpose.h1, note: `Подходят ${items.length} ${plural(items.length, 'позиция', 'позиции', 'позиций')}` }} />
<section class="sec sec-tight" aria-labelledby="pick-h">
  <div class="wrap">
    <SectionHead id="pick-h" label="Подбор" title="Какая марка нужна" sub={`для ${purpose.name}`} desc="Подсказки технолога. Точную марку подберём по проекту и грунту." />
    <div class="pur-grid">
      {cards.map((c) => (
        <a class:list={['pur', { 'pur-on': c.slug === purpose.slug }]} href={purposeHref(c.slug)}>
          <span class="pur-h"><b>{purposeLabel(c.h1)}</b><span class="pur-badge">берут {c.recommended}</span></span>
          <span class="pur-d">{c.short}</span>
          <span class="pur-tip"><Icon name="circle-help" size={16} />{c.tip}</span>
        </a>
      ))}
    </div>
  </div>
</section>
<CalcSection />
<section class="sec sec-tight" aria-labelledby="ask-h">
  <div class="wrap">
    <SectionHead id="ask-h" label="Заявка" title="Что указать в заявке" sub="чтобы не ошибиться" desc="Диспетчер уточнит остальное по телефону." />
    <ul class="asklist card-w">{ask.map((a) => <li><span class="fbox on" aria-hidden="true"><Icon name="check" size={12} stroke={3} /></span>{a}</li>)}</ul>
  </div>
</section>
<section class="sec sec-tight" aria-labelledby="tips-h">
  <div class="wrap">
    <SectionHead id="tips-h" label="Советы" title="Советы технолога" sub="перед заливкой" desc="Коротко о том, что чаще всего спрашивают на объекте." more={{ href: '/blog/', label: 'Все статьи' }} />
    <TipCards />
  </div>
</section>
<DeliveryZones>
  <div class="banner">
    <div class="banner-t"><p class="banner-h">Нужен бетононасос?</p><p>Подадим бетон туда, куда миксер не доедет: на этаж, через забор, в подвал.</p></div>
    <a class="btn btn-light" href="/price/#uslugi">Аренда бетононасоса<Icon name="arrow-right" size={16} /></a>
  </div>
</DeliveryZones>
<PopularBlock />
<FaqSection />
<LinkCloud current={purposeHref(purpose.slug)} />
<SeoSection />
