---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PageHead from '../../components/ui/PageHead.astro';
import Block from '../../components/ui/Block.astro';
import Container from '../../components/ui/Container.astro';
import ImagePlaceholder from '../../components/ui/ImagePlaceholder.astro';
import CtaFinal from '../../components/blocks/CtaFinal.astro';
import posts from '../../data/posts.json';
import { getProduct, productPath } from '../../lib/catalog';
import { formatPrice } from '../../lib/price';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props as { post: (typeof posts)[number] };
const related = post.products.map(getProduct).filter(Boolean);
const others = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
---
<BaseLayout title={`${post.title}`} description={post.excerpt} template="T16" templateName="Публикация">
  <Breadcrumbs items={[{ href: '/blog/', label: 'Блог' }, { label: post.title }]} />
  <PageHead id="BD-01" name="H1 публикации" h1={post.title} lead={post.excerpt}>
    <p class="mt-3 text-sm text-ink-2">{post.date} · {post.rubric} · чтение {post.read}</p>
  </PageHead>

  <Block id="BD-02" name="Текст статьи">
    <Container class="py-12">
      <div class="max-w-3xl">
        <ImagePlaceholder label={`Иллюстрация: ${post.title.toLowerCase()}`} ratio="16:9" />

        <h2 class="mt-8 text-lg font-semibold">Коротко</h2>
        <p class="mt-3 text-[15px] text-ink-2">Текст статьи добавляется на этапе наполнения. В прототипе показана структура: вводный абзац, два-три подзаголовка, врезка с главной мыслью и таблица с параметрами.</p>

        <h2 class="mt-8 text-lg font-semibold">Как это работает на практике</h2>
        <p class="mt-3 text-[15px] text-ink-2">Абзац с разбором ситуации на объекте: что обычно делают неправильно и к чему это приводит. Тон спокойный, без давления на читателя.</p>

        <div class="mt-6 rounded-md border-l-2 border-accent bg-block p-4 text-sm">
          Врезка: главный вывод статьи в одно предложение, чтобы его можно было прочитать, не читая весь текст.
        </div>

        <h2 class="mt-8 text-lg font-semibold">Таблица параметров</h2>
        <div class="table-scroll mt-3 rounded-md border border-line bg-white">
          <table class="w-full min-w-[420px] text-sm">
            <thead class="bg-block text-left text-xs text-ink-2">
              <tr><th class="px-4 py-3 font-medium">Параметр</th><th class="px-4 py-3 font-medium">Значение</th><th class="px-4 py-3 font-medium">Комментарий</th></tr>
            </thead>
            <tbody class="divide-y divide-line">
              <tr><td class="px-4 py-3">Марка</td><td class="px-4 py-3">М200 и выше</td><td class="px-4 py-3 text-ink-2">зависит от конструкции</td></tr>
              <tr><td class="px-4 py-3">Морозостойкость</td><td class="px-4 py-3">от F150</td><td class="px-4 py-3 text-ink-2">для наружных конструкций</td></tr>
              <tr><td class="px-4 py-3">Запас объёма</td><td class="px-4 py-3">5 процентов</td><td class="px-4 py-3 text-ink-2">на деформацию опалубки</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </Container>
  </Block>

  {related.length > 0 && (
    <Block id="BD-04" name="Товары по теме" tone="block">
      <Container class="py-12">
        <h2 class="text-lg font-semibold">Позиции по теме</h2>
        <div class="mt-4 grid gap-3 md:grid-cols-3 lg:grid-cols-4">
          {related.map((p) => p && (
            <a href={productPath(p)} class="rounded-md border border-line bg-white p-4 hover:border-accent">
              <div class="font-medium">{p.name}</div>
              <div class="mt-2 text-sm text-ink-2">{formatPrice(p.price)} ₽ за м³</div>
            </a>
          ))}
        </div>
      </Container>
    </Block>
  )}

  <Block id="BD-05" name="Другие публикации">
    <Container class="py-12">
      <h2 class="text-lg font-semibold">Читайте также</h2>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        {others.map((p) => (
          <a href={`/blog/${p.slug}/`} class="rounded-md border border-line bg-white p-4 hover:border-accent">
            <div class="text-xs text-ink-2">{p.date}</div>
            <div class="mt-1 font-medium">{p.title}</div>
          </a>
        ))}
      </div>
    </Container>
  </Block>

  <CtaFinal />
</BaseLayout>
